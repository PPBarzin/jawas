# Core runtime
TARGET_PROTOCOL=KAMINO
ENABLE_OBSERVER=true
ENABLE_HUNTER=true

# Shared fallback RPC
RPC_URL=https://api.mainnet-beta.solana.com
WS_URL=wss://api.mainnet-beta.solana.com

# Observer role
# Example provider: QuickNode
OBSERVER_RPC_URL=https://your-observer-rpc.example
OBSERVER_WS_URL=wss://your-observer-ws.example
OBSERVER_TX_COMMITMENT=confirmed

# Hunter role
# Example provider: Helius
HUNTER_RPC_URL=https://your-hunter-rpc.example
HUNTER_WS_URL=wss://your-hunter-ws.example
HUNTER_TX_COMMITMENT=confirmed

# Optional secondary signal source for hunter-only comparisons
HUNTER_SIGNAL_SECONDARY_RPC_URL=https://your-hunter-signal-secondary-rpc.example
HUNTER_SIGNAL_SECONDARY_WS_URL=wss://your-hunter-signal-secondary-ws.example
HUNTER_SIGNAL_SECONDARY_TX_COMMITMENT=confirmed

# Solana execution
SOLANA_KEYPAIR_PATH=secrets/keypair.json
WALLET_TOML_PATH=wallet.toml
JITO_URL=https://mainnet.block-engine.jito.wtf/api/v1/bundles
JUPITER_BASE_URL=https://quote-api.jup.ag/v6
MAX_REPAY_USD=300.0

# Airtable logging
AIRTABLE_TOKEN=your_airtable_token
AIRTABLE_BASE_ID=your_airtable_base_id
AIRTABLE_TABLE_WATCH=Jawas-Watch

# Logging
LOG_FILE=kamino_raw-today.jsonl
HUNTER_LOG_FILE=hunter_trace.jsonl
HUNTER_SIGNAL_METRICS_FILE=hunter_signal_metrics.jsonl

# Hunter runtime
HUNTER_DRY_RUN=false
HUNTER_REPLAY=false
HUNTER_SIGNAL_LOCK_MS=3000
JITO_SEND_MAX_ATTEMPTS=2

# Kamino execution tuning
KAMINO_COMPUTE_UNIT_LIMIT=500000
KAMINO_CU_PRICE_MICROLAMPORTS=15000
# KAMINO_GET_TX_ATTEMPTS=6
# KAMINO_GET_TX_RETRY_DELAY_MS=150
# KAMINO_GET_TX_TIMEOUT_MS=3000

# Hunter signal routing
ENABLE_HUNTER_SIGNAL_PRIMARY=true
ENABLE_HUNTER_SIGNAL_SECONDARY=false
ENABLE_HUNTER_SIGNAL_PRICE_FEED=false

# Optional price-feed driven signal source
SIGNAL_FEED_WS_URL=https://hermes.pyth.network
HERMES_SHORTLIST_SIZE=200
HERMES_REFRESH_SECS=10
HERMES_TRIGGER_BUFFER_BPS=25
